{
  "name": "neuroin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:server": "node --import tsx --test server/*.test.ts",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "vapid:generate": "web-push generate-vapid-keys --json"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.2.0",
    "@fontsource/poppins": "^5.2.0",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5"
  }
}
