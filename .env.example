# Node.js 24 LTS. Variáveis lidas somente pelo servidor (nunca usar prefixo VITE_).
PORT=3001
DB_PATH=./data/neuroin.sqlite
# Em produção, endereço público HTTPS exato, sem barra final.
PUBLIC_ORIGIN=http://127.0.0.1:5173
VAPID_SUBJECT=mailto:contato@example.com
# Gerar o par com npm run vapid:generate; guardar a chave privada somente no servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
